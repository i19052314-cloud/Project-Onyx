<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    ONYX ADMIN - companion admin panel for Onyx RP.
    ScriptHookVDotNet v3 (Legacy line).

    This is a companion trainer, not a change to Onyx RP: it calls only public
    ScriptHookVDotNet API and writes only to <GTA>\\OnyxAdmin\\.

    Build requirements
      * Visual Studio 2019/2022 (Community is fine), ".NET desktop development"
      * .NET Framework 4.8 targeting pack
      * ScriptHookVDotNet 3.x for the GTA V **Legacy** line (3.6/3.7 API — see
        ProjectOnyx README: do NOT mix with the Enhanced 3.9 runtime)

    Where to put ScriptHookVDotNet3.dll
      Drop it in  lib\shvdn3\  next to this folder, or override the property:
        msbuild /p:SHVDN3Dir=C:\Path\To\SHVDN3\
      Only the reference assembly is needed to compile; nothing is copied to
      the output (the game loads its own copy from the GTA folder).
  -->
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{2D9F41B7-5C63-4E8A-9B24-7A1E0D3C58F6}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>OnyxAdmin</RootNamespace>
    <AssemblyName>OnyxAdmin</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Folder holding ScriptHookVDotNet3.dll at build time -->
    <SHVDN3Dir Condition=" '$(SHVDN3Dir)' == '' ">$(MSBuildThisFileDirectory)..\..\lib\shvdn3\</SHVDN3Dir>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ScriptHookVDotNet3">
      <HintPath>$(SHVDN3Dir)ScriptHookVDotNet3.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Core\Log.cs" />
    <Compile Include="Core\Ini.cs" />
    <Compile Include="Core\Keys.cs" />
    <Compile Include="Presentation\Draw.cs" />
    <Compile Include="MenuItem.cs" />
    <Compile Include="AdminSettings.cs" />
    <Compile Include="AdminState.cs" />
    <Compile Include="AdminActions.cs" />
    <Compile Include="AdminPanel.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Main.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <Target Name="CheckShvdn3" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(SHVDN3Dir)ScriptHookVDotNet3.dll')"
           Text="ScriptHookVDotNet3.dll not found in '$(SHVDN3Dir)'. Copy it there or build with /p:SHVDN3Dir=C:\Path\To\SHVDN3\" />
  </Target>

  <!-- Optional convenience: uncomment and set GtaDir to copy the build straight
       into the game folder after a successful build.
  <Target Name="CopyToGame" AfterTargets="Build" Condition=" '$(GtaDir)' != '' ">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GtaDir)\scripts" />
  </Target>
  -->
</Project>
