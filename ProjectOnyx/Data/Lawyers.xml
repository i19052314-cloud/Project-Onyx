      <Question Text="A suspect was never told of their right to remain silent before questioning. What can the defense ask for?">
        <Answer Text="Suppress the statements made in that questioning." Correct="true"/>
        <Answer Text="A new judge."/>
        <Answer Text="A lighter fine for the police."/>
        <Answer Text="Nothing; the rights do not matter."/>
      </Question>
      <Question Text="The police searched a car with no warrant, no consent, and no probable cause. What happens to what they found?">
        <Answer Text="It is always allowed in court."/>
        <Answer Text="It can be excluded from the trial." Correct="true"/>
        <Answer Text="It goes to the victim."/>
        <Answer Text="The car is returned to the police."/>
      </Question>
      <Question Text="The only witness says they saw the suspect at night from 200 metres away. What do you argue?">
        <Answer Text="The witness is related to the judge."/>
        <Answer Text="Nothing can be argued about a witness."/>
        <Answer Text="The identification is unreliable." Correct="true"/>
        <Answer Text="The suspect should plead guilty."/>
      </Question>
      <Question Text="Your client was charged twice for the same act after being acquitted. What protects them?">
        <Answer Text="Attorney-client privilege."/>
        <Answer Text="The statute of frauds."/>
        <Answer Text="Probable cause."/>
        <Answer Text="Double jeopardy." Correct="true"/>
      </Question>
      <Question Text="The prosecution has no physical evidence, only a rumor. What is the standard they fail to meet?">
        <Answer Text="Proof beyond a reasonable doubt." Correct="true"/>
        <Answer Text="Preponderance of the gossip."/>
        <Answer Text="Good faith."/>
        <Answer Text="Strict liability."/>
      </Question>
      <Question Text="Your client acted to stop someone from stabbing them. Which defense fits?">
        <Answer Text="Insanity."/>
        <Answer Text="Self-defense." Correct="true"/>
        <Answer Text="Entrapment."/>
        <Answer Text="Necessity of the state."/>
      </Question>
      <Question Text="An undercover officer pressured your client for weeks into a crime they never planned. Which defense fits?">
        <Answer Text="Duress by a stranger."/>
        <Answer Text="Mistake of law."/>
        <Answer Text="Entrapment." Correct="true"/>
        <Answer Text="Alibi."/>
      </Question>
      <Question Text="Your client was at work across town at the time of the robbery, and their manager can confirm it. What is this?">
        <Answer Text="Hearsay."/>
        <Answer Text="A confession."/>
        <Answer Text="Character evidence."/>
        <Answer Text="An alibi." Correct="true"/>
      </Question>
      <Question Text="Your client was arrested without probable cause. What can you argue?">
        <Answer Text="The arrest was unlawful, so what followed may be thrown out." Correct="true"/>
        <Answer Text="The client must pay a fee."/>
        <Answer Text="The client waives every right."/>
        <Answer Text="Nothing; an arrest is always lawful."/>
      </Question>
      <Question Text="The lab that tested the drugs lost the sample's paperwork. What do you challenge?">
        <Answer Text="The judge's robe."/>
        <Answer Text="The chain of custody." Correct="true"/>
        <Answer Text="The jury's lunch."/>
        <Answer Text="The client's driving record."/>
      </Question>
      <Question Text="A key witness was promised a deal for testifying against your client. What do you raise?">
        <Answer Text="Nothing; deals are secret."/>
        <Answer Text="The witness's age."/>
        <Answer Text="The witness's possible bias." Correct="true"/>
        <Answer Text="The weather that day."/>
      </Question>
      <Question Text="Your client is charged with a crime that was not a law when they did it. What do you argue?">
        <Answer Text="The jury is too small."/>
        <Answer Text="The court is too far away."/>
        <Answer Text="The client should pay double."/>
        <Answer Text="A law cannot punish acts done before it existed." Correct="true"/>
      </Question>
    </Cases>
