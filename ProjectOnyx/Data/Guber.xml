<!-- Güber ride app. Fare, cooldown, NPC drivers and driving are the original's; the driver side follows the taxi job. -->
<Onyx>
  <Guber>
    <!-- Fare = Base + PerKm x straight-line km, at least Minimum; the rider also pays ServiceFee (kept by the app).
         v338: x10 (lead: "instead of a $25 fare, it should now be a $250 fare"). -->
    <Fare Base="50.0" PerKm="20.0" Minimum="100.0" ServiceFee="2.0" RequestCooldownSeconds="30" />
    <!-- v367: what a ride pays the human when the human is the DRIVER (Base + PerKm x km, at least Minimum).
         What a rider pays is the Fare line above and is not changed. -->
    <DriverFare Base="150.0" PerKm="60.0" Minimum="300.0" />
    <!-- The NPC driver drives at Speed m/s with this driving style and stops within StopRange metres. -->
    <Driving Speed="15.0" Style="786469" StopRange="4.0" />
    <!-- While riding: Hurry (H) and Skip (E) cost these flat fees, added to the ride's total. A hurried driver drives at
         HurrySpeed m/s with HurryStyle (1074528293 = rushed). -->
    <Ride HurryFee="10" SkipFee="25" HurrySpeed="25.0" HurryStyle="1074528293" />
    <!-- The original's four driver spawns, each moved to its nearest road node (CodeWalker, 2026-10-29). -->
    <DriverSpawns>
      <Point X="-271.00" Y="-863.25" Z="30.56" H="249.15" />
      <Point X="187.00" Y="-196.50" Z="53.13" H="71.08" />
      <Point X="514.25" Y="-181.75" Z="52.81" H="12.80" />
      <Point X="-1035.00" Y="-2724.00" Z="19.19" H="239.42" />
    </DriverSpawns>
    <DriverVehicles><Model Name="surge" /><Model Name="dilettante" /><Model Name="asea" /></DriverVehicles>
    <DriverPeds><Model Name="a_m_y_business_01" /><Model Name="a_m_y_business_02" /><Model Name="a_m_y_hipster_01" /><Model Name="a_m_y_indian_01" /><Model Name="a_f_y_business_01" /></DriverPeds>
    <!-- Pickup blip of the rider's ride. -->
    <Blip Sprite="56" Colour="5" />
    <!-- The human driver: a request every 30-90 s while driving (the taxi job's dispatch), stop within 15 m to board
         and to drop off, an NPC customer appears within 75 m of the pickup. v338: riders are picked up within PickupRadius
         metres of you (NPC customers on the pavement there; Playerz riders standing there); PlayerzMaxDistance is for
         Playerz drivers. -->
    <Dispatch MinSeconds="30" MaxSeconds="90" StopRadius="15.0" SpawnRadius="75.0" OfferSeconds="20" PlayerzMaxDistance="2000" PickupRadius="500" />
    <!-- Sign-up: a driver's license and no serious arrest within RecordDays in-game days. -->
    <Rules LicenseItem="drivers_license" RecordDays="7" />
    <!-- Tips: the human picks one of these percents; Playerz/NPC riders tip 0..RiderTipMax percent. -->
    <Tips Options="0,10,15,20" RiderTipMax="20" />
    <!-- Playerz on Güber duty: a shift of these minutes; a Playerz rider's request waits OfferSeconds for the human. -->
    <Playerz ShiftMinMinutes="10" ShiftMaxMinutes="20" />
    <!-- The map picture: px = Scale*x + OffsetX, py = -Scale*y + OffsetY (fitted to the road data, 2026-10-29). -->
    <Map File="Phone/Guber/map.png" Width="1636" Height="2000" Scale="0.17760" OffsetX="788.0" OffsetY="1335.0" />
  </Guber>
</Onyx>
