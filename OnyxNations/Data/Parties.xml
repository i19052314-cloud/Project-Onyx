<!-- ONYX RP: NATIONS & WAR — parties and election rules (milestone M3).

     TaxBias      -0.20 .. +0.20   where the party wants the tax rate, relative
                                   to the 0.24 status quo. Wins -> it actually
                                   moves (slowly), and the economy reacts.
     Hawkishness  0 .. 1           how much of the budget goes to the army, and
                                   how willing the party is to keep a war going.
     Popularity   0 .. 1           baseline vote share, before the incumbent's
                                   record is taken into account.

     IsPlayerParty = true marks the party the player leads. Exactly one per
     nation, or the player is a non-partisan independent.
-->

<OnyxNations>
  <!-- One term is 120 game days. Five game days pass per real minute, so a
       president faces the voters every 24 minutes of play and campaigns for the
       last five of them. Long enough to govern, short enough to actually see. -->
  <ElectionRules
      TermDays="120"
      MaxTerms="2"
      CampaignDays="25"
      MinTurnout="0.35"
      MaxTurnout="0.85"
      IncumbencyBonus="0.06"
      WarRallyBonus="0.10"
      ScandalPenalty="0.25"
      ChallengerFundsPerDay="45000"
      PlayerFundsPerDay="60000" />

  <Parties>

    <Party ID="rsa_civic" Nation="rsa" Name="Civic Union" NameRu="Гражданский союз"
           TaxBias="-0.04" Hawkishness="0.30" Popularity="0.34"
           R="60" G="120" B="200" IsPlayerParty="true"/>
    <Party ID="rsa_first" Nation="rsa" Name="San Andreas First" NameRu="Сан-Андреас прежде всего"
           TaxBias="0.03" Hawkishness="0.78" Popularity="0.31"
           R="200" G="70" B="60" IsPlayerParty="false"/>
    <Party ID="rsa_labour" Nation="rsa" Name="Labour &amp; Ports" NameRu="Труд и порты"
           TaxBias="0.08" Hawkishness="0.20" Popularity="0.28"
           R="210" G="150" B="50" IsPlayerParty="false"/>

    <Party ID="fzsa_unity" Nation="fzsa" Name="Federation Unity" NameRu="Единство Федерации"
           TaxBias="0.02" Hawkishness="0.70" Popularity="0.38"
           R="210" G="100" B="45" IsPlayerParty="false"/>
    <Party ID="fzsa_frontier" Nation="fzsa" Name="Frontier League" NameRu="Лига фронтира"
